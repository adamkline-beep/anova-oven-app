rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account can read and write only its own subtree. Nothing is
    // public, and no account can see another's recipes.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One document per share, addressed by an unguessable 32-character id, so
    // a helper can read the recipe list on a phone with no account. Readable
    // by anyone holding the id; writable only by the account that made it.
    match /shared/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
